        <item name="colorSurfaceBright">?android:attr/colorBackground</item>
        <item name="againTextColor">@color/material_red_900</item>
        <item name="hardTextColor">#B33800</item>
        <item name="goodTextColor">@color/material_green_900</item>
        <item name="easyTextColor">@color/material_light_blue_900</item>
